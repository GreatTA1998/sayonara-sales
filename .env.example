# Shop state — Firebase Firestore (project sayonara-sales, asia-northeast1)
FIREBASE_PROJECT_ID=sayonara-sales
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional instead of CLIENT_EMAIL + PRIVATE_KEY:
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Photos still on Vercel Blob (auto when Blob linked)
BLOB_READ_WRITE_TOKEN=

# Optional LINE Login (OAuth). Soft LINE名 works without these.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Optional; default is {origin}/api/auth/line/callback
LINE_CALLBACK_URL=
NEXT_PUBLIC_SITE_URL=https://sayonara.tokyo
