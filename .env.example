# Client Firebase (public — set on Vercel; no SA keys)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sayonara-sales.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sayonara-sales
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sayonara-sales.firebasestorage.app

# Photos still on Vercel Blob (auto when Blob linked)
BLOB_READ_WRITE_TOKEN=

# Optional LINE Login (OAuth). Soft Jimoty名 works without these.
# Callback is always {request host}/api/auth/line/callback (beta/apex/vercel.app).
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Messaging API channel access token (same provider as Login; OA linked). Push no-ops if unset.
LINE_CHANNEL_ACCESS_TOKEN=
NEXT_PUBLIC_SITE_URL=https://sayonara.tokyo
# Optional: Cursor Automation webhook (Help→auto-fix). Paste URL from Automations dashboard.
REPORT_WEBHOOK_URL=
# Optional: Bearer token from "Generate auth header" (raw key or full "Bearer …")
REPORT_WEBHOOK_AUTH=
# Max cloud-agent kicks per UTC day (default 5). Set 0 to disable kicks.
AUTOFIX_DAILY_CAP=5
