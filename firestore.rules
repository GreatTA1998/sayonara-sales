rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function shopDoc(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data;
    }
    function isOwner(shopId) {
      return signedIn()
        && 'ownerUid' in shopDoc(shopId)
        && shopDoc(shopId).ownerUid == request.auth.uid;
    }
    // Soft Jimoty era: elton writable by any signed-in anon (no hard account yet).
    function canAdmin(shopId) {
      return signedIn() && (shopId == 'elton' || isOwner(shopId));
    }
    // Claimable dig5s (no ownerUid) — /admin wipe after typing OK.
    function unclaimed(shopId) {
      return shopId != 'elton' && !('ownerUid' in shopDoc(shopId));
    }
    // Unclaimed dig5: any signed-in user, including anonymous auth. Not a claim.
    function canEdit(shopId) {
      return canAdmin(shopId) || (signedIn() && unclaimed(shopId));
    }
    function ownerFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'ownerUid', 'ownerLineUid', 'ownerJimotyName', 'ownerLineName', 'ownerFacebookName'
      ]);
    }
    function claimOf(shopId, claimId) {
      return get(/databases/$(database)/documents/shops/$(shopId)/claims/$(claimId)).data;
    }
    // Soft Jimoty: contact matches Auth displayName (token.name). Or buyerUid.
    function ownsClaim() {
      return signedIn() && (
        ('buyerUid' in resource.data && resource.data.buyerUid == request.auth.uid)
        || (resource.data.contact is string
            && resource.data.contact.size() > 0
            && request.auth.token.name == resource.data.contact)
      );
    }
    function ownsClaimDoc(shopId, claimId) {
      let c = claimOf(shopId, claimId);
      return signedIn() && (
        ('buyerUid' in c && c.buyerUid == request.auth.uid)
        || (c.contact is string && c.contact.size() > 0
            && request.auth.token.name == c.contact)
      );
    }
    function openClaim() {
      return resource.data.status == 'requested' || resource.data.status == 'booked';
    }
    // Buyer cancel: status→cancelled (+ optional declineReason). Back-up waiters stay on the
    // cancelled claim so the owner can promote the next one.
    function buyerCancel() {
      return ownsClaim() && openClaim()
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'waiters', 'declineReason']);
    }
    // Buyer 日程変更: day+slot only.
    function buyerResched() {
      return ownsClaim() && openClaim()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['day', 'slot'])
        && request.resource.data.day is string
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.slot is string;
    }
    // One shop per Firebase uid — written in the same claim transaction as ownerUid.
    match /uids/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['shopId'])
        && request.resource.data.shopId is string;
      allow update, delete: if false;
    }

    match /shops/{shopId} {
      // Public reads: unpublished = private link preview; home queries published==true.
      allow read: if true;

      // Create does not claim or publish. Any signed-in uid, including anonymous.
      allow create: if signedIn()
        && request.resource.data.published == false
        && !('ownerUid' in request.resource.data)
        && !('ownerLineUid' in request.resource.data);

      // Owner edits. Anyone signed-in may edit/publish an unclaimed shop, but
      // that write cannot set owner fields. Claim is the only ownerUid stamp.
      // getAfter sees uids/{uid} created in the same claim transaction.
      allow update: if canAdmin(shopId)
        || (signedIn() && unclaimed(shopId) && ownerFieldsUntouched())
        || (signedIn() && !('ownerUid' in resource.data)
            && request.resource.data.ownerUid == request.auth.uid
            && existsAfter(/databases/$(database)/documents/uids/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/uids/$(request.auth.uid)).data.shopId == shopId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'ownerUid', 'updatedAt', 'ownerJimotyName', 'ownerLineName', 'ownerFacebookName', 'ownerLineUid'
            ]));

      // Empty-shop cleanup (SS-288); unclaimed dig5 wipe from /admin (OK confirm).
      allow delete: if canAdmin(shopId) || (signedIn() && unclaimed(shopId));

      match /items/{itemId} {
        allow read: if true;
        allow create: if canEdit(shopId);
        allow delete: if canEdit(shopId) || (signedIn() && unclaimed(shopId));
        // Book: set claimId when free. Buyer cancel: clear claimId on own claim.
        allow update: if canEdit(shopId) || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimId'])
          && (
            (resource.data.claimId == null && request.resource.data.claimId is string)
            || (
              resource.data.claimId is string
              && request.resource.data.claimId == null
              && ownsClaimDoc(shopId, resource.data.claimId)
            )
          )
        );
      }

      // Public Q&A under an item. Anyone reads. Signed-in (anonymous ok) posts as
      // themselves with a name; `seller: true` only from the shop admin (canAdmin).
      // 15s cooldown per uid via commentMeta, written in the same batch (at == request.time).
      match /items/{itemId}/comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/shops/$(shopId)/items/$(itemId))
          && request.resource.data.keys().hasOnly(['authorUid', 'name', 'text', 'seller', 'at'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.seller is bool
          && (request.resource.data.seller == false || canAdmin(shopId))
          && request.resource.data.at == request.time
          && getAfter(/databases/$(database)/documents/shops/$(shopId)/commentMeta/$(request.auth.uid)).data.at == request.time
          && (!exists(/databases/$(database)/documents/shops/$(shopId)/commentMeta/$(request.auth.uid))
              || get(/databases/$(database)/documents/shops/$(shopId)/commentMeta/$(request.auth.uid)).data.at
                  < request.time - duration.value(15, 's'));
        allow update: if false;
        // Author removes their own; shop admin (or anyone on an unclaimed shop, as elsewhere) removes spam.
        allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || canEdit(shopId));
      }

      // Comment cooldown stamp, one doc per uid. Only writable alongside a comment.
      match /commentMeta/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time;
        allow delete: if false;
      }

      match /claims/{claimId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.buyerUid == request.auth.uid
          && request.resource.data.status == 'requested';
        allow update: if canAdmin(shopId)
          || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['waiters']))
          || buyerCancel()
          || buyerResched();
        allow delete: if canAdmin(shopId) || (signedIn() && unclaimed(shopId));
      }
    }

    // Shop-builder idempotency lock. Doc id is the hash of source + seller.
    // Not a claim: no ownerUid. shopId is fixed unless that shop doc is gone.
    match /shopSources/{keyId} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['shopId', 'source', 'sellerId'])
        && request.resource.data.shopId.matches('^[0-9][0-9][0-9][0-9][0-9]$')
        && request.resource.data.source is string
        && request.resource.data.source.size() > 0
        && request.resource.data.source.size() <= 64
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId.size() > 0
        && request.resource.data.sellerId.size() <= 500;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shopId'])
        && request.resource.data.shopId.matches('^[0-9][0-9][0-9][0-9][0-9]$')
        && !exists(/databases/$(database)/documents/shops/$(resource.data.shopId));
      allow delete: if false;
    }
  }
}
