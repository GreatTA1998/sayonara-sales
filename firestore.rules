rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function shopDoc(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data;
    }
    function isOwner(shopId) {
      return signedIn()
        && 'ownerUid' in shopDoc(shopId)
        && shopDoc(shopId).ownerUid == request.auth.uid;
    }
    // Soft Jimoty era: elton writable by any signed-in anon (no hard account yet).
    function canAdmin(shopId) {
      return signedIn() && (shopId == 'elton' || isOwner(shopId));
    }
    // Claimable dig5s (no ownerUid) — /admin wipe after typing OK.
    function unclaimed(shopId) {
      return shopId != 'elton' && !('ownerUid' in shopDoc(shopId));
    }
    // Preparer: anon uid stamped at create. Edits are not a claim and stay unpublished.
    function isCreator(shopId) {
      return signedIn()
        && 'creatorUid' in shopDoc(shopId)
        && shopDoc(shopId).creatorUid == request.auth.uid;
    }
    function canPrepare(shopId) {
      return isCreator(shopId) && unclaimed(shopId);
    }
    function canEdit(shopId) {
      return canAdmin(shopId) || canPrepare(shopId);
    }
    function ownerFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'ownerUid', 'ownerLineUid', 'ownerJimotyName', 'ownerLineName', 'ownerFacebookName'
      ]);
    }
    function staysUnpublished() {
      return request.resource.data.published != true;
    }

    // One shop per Firebase uid — written in the same claim transaction as ownerUid.
    match /uids/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['shopId'])
        && request.resource.data.shopId is string;
      allow update, delete: if false;
    }

    match /shops/{shopId} {
      // Public reads: unpublished = private link preview; home filters published client-side.
      allow read: if true;

      // New shop: creatorUid is the anon preparer. Create does not claim or publish.
      allow create: if signedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.published == false
        && !('ownerUid' in request.resource.data)
        && !('ownerLineUid' in request.resource.data);

      // Owner edits. Preparer edits an unclaimed shop without claiming or publishing.
      // Legacy docs with no creatorUid: first signed-in editor stamps themselves.
      // First claim: no ownerUid yet → stamp self. getAfter sees uids/{uid} created
      // in the same transaction. A different user (the seller) may claim.
      allow update: if canAdmin(shopId)
        || (canPrepare(shopId)
            && request.resource.data.creatorUid == resource.data.creatorUid
            && staysUnpublished()
            && ownerFieldsUntouched())
        || (signedIn() && unclaimed(shopId) && !('creatorUid' in resource.data)
            && request.resource.data.creatorUid == request.auth.uid
            && staysUnpublished()
            && ownerFieldsUntouched())
        || (signedIn() && !('ownerUid' in resource.data)
            && request.resource.data.ownerUid == request.auth.uid
            && existsAfter(/databases/$(database)/documents/uids/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/uids/$(request.auth.uid)).data.shopId == shopId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'ownerUid', 'updatedAt', 'ownerJimotyName', 'ownerLineName', 'ownerFacebookName', 'ownerLineUid'
            ]));

      // Empty-shop cleanup (SS-288); unclaimed dig5 wipe from /admin (OK confirm).
      allow delete: if canAdmin(shopId) || (signedIn() && unclaimed(shopId));

      match /items/{itemId} {
        allow read: if true;
        allow create: if canEdit(shopId);
        allow delete: if canEdit(shopId) || (signedIn() && unclaimed(shopId));
        allow update: if canEdit(shopId) || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimId'])
          && resource.data.claimId == null
          && request.resource.data.claimId is string
        );
      }

      match /claims/{claimId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.buyerUid == request.auth.uid
          && request.resource.data.status == 'requested';
        allow update: if canAdmin(shopId) || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['waiters'])
        );
        allow delete: if canAdmin(shopId) || (signedIn() && unclaimed(shopId));
      }
    }
  }
}
